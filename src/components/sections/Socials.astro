---
import SocialCard from '../cards/SocialCard.astro';

const github = { url: 'https://github.com/dcarrascov', handle: '@dcarrascov' };
const linkedin = {
	url: 'https://www.linkedin.com/in/diego-carrasco-villaran/',
	name: 'Diego M. Carrasco Villarán',
};
---

<SocialCard href={github.url} title="GitHub" subtitle={github.handle} tone="dark">
	<svg
		width="28"
		height="28"
		viewBox="0 0 24 24"
		fill="none"
		stroke="#ffffff"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path
			d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3.1-.3 6.4-1.5 6.4-7A5.4 5.4 0 0 0 20 4.8 5 5 0 0 0 19.9 1S18.7.7 16 2.5a13.4 13.4 0 0 0-7 0C6.3.7 5.1 1 5.1 1A5 5 0 0 0 5 4.8a5.4 5.4 0 0 0-1.5 3.7c0 5.4 3.3 6.6 6.4 7A3.4 3.4 0 0 0 9 18.1V22"
		></path>
	</svg>
</SocialCard>

<SocialCard href={linkedin.url} title="LinkedIn" subtitle={linkedin.name}>
	<svg
		width="28"
		height="28"
		viewBox="0 0 24 24"
		fill="none"
		stroke="var(--accent-2)"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<rect x="2" y="2" width="20" height="20" rx="4"></rect>
		<path d="M7 10v7M7 7v.01M11 17v-4a2 2 0 0 1 4 0v4M11 10v7"></path>
	</svg>
</SocialCard>
