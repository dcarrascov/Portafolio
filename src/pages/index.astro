---
import AiProjects from '../components/sections/AiProjects.astro';
import Certificates from '../components/sections/Certificates.astro';
import ContactCard from '../components/sections/ContactCard.astro';
import Education from '../components/sections/Education.astro';
import Experience from '../components/sections/Experience.astro';
import FeaturedProject from '../components/sections/FeaturedProject.astro';
import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import Socials from '../components/sections/Socials.astro';
import Stack from '../components/sections/Stack.astro';
import Header from '../layouts/Header.astro';
import Layout from '../layouts/Layout.astro';

const title = 'Diego M. Carrasco Villarán';
const description =
	'Desarrollador Java con ganas de aprender y de ayudar. Si algo se puede hacer más fácil y eficiente con software, quiero ser quien lo construya o, al menos, aportar mi grano de arena.';
const fullName = 'Diego Manuel Carrasco Villarán';
---

<Layout title={title} description={description}>
	<div class="page">
		<div class="container">
			<Header />

			<main class="bento">
				<Hero />
				<FeaturedProject />
				<Socials />
				<Experience />
				<Education />
				<Projects />
				<AiProjects />
				<Certificates />
				<Stack />
				<ContactCard />
			</main>

			<footer>© 2026 {fullName}</footer>
		</div>
	</div>
</Layout>

<style>
	.page {
		box-sizing: border-box;
		min-height: 100vh;
		padding: 48px 24px;
	}

	.container {
		max-width: 1120px;
		margin: 0 auto;
	}

	.bento {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
	}

	footer {
		margin-top: 40px;
		text-align: center;
		font-size: 13px;
		color: var(--ink-muted);
	}

	@media (max-width: 760px) {
		.bento {
			grid-template-columns: 1fr;
		}
	}
</style>
