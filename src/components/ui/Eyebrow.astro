---
interface Props {
	tone?: 'accent' | 'inherit' | 'mint';
}

const { tone = 'accent' } = Astro.props;
---

<span class:list={['eyebrow', tone]}><slot /></span>

<style>
	.eyebrow {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.accent {
		color: var(--accent-2);
	}

	.mint {
		color: var(--mint-ink);
	}
</style>
