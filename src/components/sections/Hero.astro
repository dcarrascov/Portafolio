---
import Card from '../ui/Card.astro';

const profile = {
	name: 'Diego M. Carrasco Villarán',
	greeting: 'Hola, soy Diego M.',
	intro:
		'Desarrollador Java con ganas de aprender y de ayudar. Si algo se puede hacer más fácil y eficiente con software, quiero ser quien lo construya o, al menos, aportar mi grano de arena.',
	location: 'Huelva',
	status: 'Buscando prácticas (FCT)',
	photo: '/dbf8d7d1476efad72a8e60c45dbde621.jpg',
};
---

<Card class="hero" wide tall padding={40} gap={20} justify="center">
	<div class="top">
		<img
			class="photo"
			src={profile.photo}
			alt={`Foto de ${profile.name}`}
			width="120"
			height="120"
		/>
		<div class="badges">
			<span class="location">
				<svg
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M12 22s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"></path>
					<circle cx="12" cy="10" r="2.5"></circle>
				</svg>
				{profile.location}
			</span>
			<span class="status"><span class="dot"></span>{profile.status}</span>
		</div>
	</div>
	<div>
		<h1>{profile.greeting}</h1>
		<p>{profile.intro}</p>
	</div>
</Card>

<style>
	.top {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		align-items: center;
		justify-content: space-between;
	}

	.photo {
		width: 120px;
		height: 120px;
		border-radius: 999px;
		object-fit: cover;
		border: 3px solid var(--bg);
	}

	.badges {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 10px;
	}

	.location {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 15px;
		font-weight: 600;
		color: var(--ink-soft);
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 14px;
		border-radius: 999px;
		background: var(--mint);
		color: var(--mint-ink);
		font-size: 14px;
		font-weight: 600;
	}

	.dot {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: var(--accent-2);
	}

	h1 {
		margin: 0;
		font-size: 44px;
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-weight: 700;
	}

	p {
		margin: 16px 0 0;
		font-size: 18px;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	@media (max-width: 760px) {
		.hero {
			--pad-mobile: 20px;
		}

		.top {
			flex-wrap: nowrap;
			justify-content: flex-start;
			gap: 12px;
		}

		/* Crece con la pantalla sin quitarle sitio al badge de prácticas */
		.photo {
			flex-shrink: 0;
			width: clamp(72px, 100vw - 288px, 96px);
			height: clamp(72px, 100vw - 288px, 96px);
		}

		.badges {
			min-width: 0;
			align-items: flex-start;
			gap: 8px;
		}

		.location {
			font-size: 14px;
		}

		.status {
			gap: 6px;
			padding: 6px 9px;
			font-size: 12px;
		}

		.dot {
			flex-shrink: 0;
			width: 6px;
			height: 6px;
		}
	}
</style>
