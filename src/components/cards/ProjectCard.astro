---
import Card from '../ui/Card.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
	label: string;
	title: string;
	description: string;
	tech?: string;
	href?: string;
}

const { label, title, description, tech, href } = Astro.props;
---

<Card href={href} padding={28} gap={10}>
	<Eyebrow>{label}</Eyebrow>
	<span class="title">{title}{href && ' →'}</span>
	<span class="description">{description}</span>
	{tech && <span class="tech">{tech}</span>}
</Card>

<style>
	.title {
		font-size: 20px;
		font-weight: 700;
	}

	.description {
		font-size: 15px;
		line-height: 1.5;
		color: var(--ink-muted);
	}

	.tech {
		font-size: 13px;
		font-weight: 600;
		color: var(--ink-soft);
	}
</style>
